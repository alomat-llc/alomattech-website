{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alomat-pilot-intake",
  "main": "workers/pilot.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "alomattech.com/api/pilot",
      "zone_name": "alomattech.com"
    }
  ],
  "ratelimits": [
    {
      "name": "PILOT_EMAIL_RATE_LIMITER",
      "namespace_id": "910001",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "PILOT_IP_RATE_LIMITER",
      "namespace_id": "910002",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "PILOT_DUPLICATE_RATE_LIMITER",
      "namespace_id": "910003",
      "simple": { "limit": 1, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
