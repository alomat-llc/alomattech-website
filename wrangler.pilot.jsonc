{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alomat-pilot-intake",
  "main": "workers/pilot.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "alomattech.com/api/pilot",
      "zone_name": "alomattech.com"
    }
  ],
  "send_email": [
    {
      "name": "PILOT_EMAIL",
      "destination_address": "hello@alomattech.com",
      "allowed_sender_addresses": ["pilot@notify.alomattech.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
