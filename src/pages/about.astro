---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { experienceNotes, site } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Learn how Alomat LLC builds and operates a managed agentic publishing platform around source intelligence, editorial memory, specialist agents, human approval, and dependable product engineering.';
const aboutData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${site.url}/about/#page`,
  name: 'About Alomat LLC',
  description,
  url: `${site.url}/about`,
  mainEntity: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout title="About Alomat LLC — Agentic Publishing Platform" description={description} pathname="/about" structuredData={[aboutData]}>
  <article class="editorial-page about-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
    <header class="editorial-hero">
      <p>Company / Alomat LLC</p>
      <h1>About Alomat: publishing operations built around editorial judgment.</h1>
      <p class="direct-answer">Alomat LLC builds and operates a managed agentic publishing platform for content creators and digital publishers, combining source intelligence, editorial memory, specialist agents, and accountable human approval.</p>
    </header>
    <section class="editorial-section" aria-labelledby="principles-title">
      <h2 id="principles-title">How we think about publishing systems</h2>
      <div class="prose-block">
        <p>Models are components inside a larger publishing operation. Useful products also need approved sources, dependable software, editorial context, tools, evaluations, observability, and accountable human decisions.</p>
        <p>Alomat starts with the editorial work a system must understand and perform. We then define where probabilistic models help, where deterministic software should lead, and how the complete workflow can be observed and improved.</p>
        <p>The operating patterns behind Alomat are already used with an active digital publisher. The customer remains private; the product evidence is a live workflow with source monitoring, archive-backed context, specialist stages, and human approval.</p>
      </div>
    </section>
    <section class="editorial-section" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience behind the platform</h2>
      <div class="experience-grid">{experienceNotes.map((note) => <article><p>{note.label}</p><h3>{note.title}</h3><p>{note.description}</p></article>)}</div>
    </section>
    <section class="editorial-section" aria-labelledby="team-title">
      <h2 id="team-title">Team</h2>
      <dl class="identity-list">
        <div><dt>Habib Salim</dt><dd>Founder</dd></div>
        <div><dt>Tulkin Yusupov</dt><dd>CTO</dd></div>
      </dl>
    </section>
    <section class="editorial-section" aria-labelledby="identity-title">
      <h2 id="identity-title">Public company identity</h2>
      <dl class="identity-list">
        <div><dt>Company</dt><dd>{site.name}</dd></div>
        <div><dt>Website</dt><dd><a href={site.url}>{site.url}</a></dd></div>
        <div><dt>General contact</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Founder contact</dt><dd><a href={`mailto:${site.founderEmail}`}>{site.founderEmail}</a></dd></div>
        <div><dt>Markets served</dt><dd>{site.markets.join(' and ')}</dd></div>
      </dl>
    </section>
  </article>
</BaseLayout>
