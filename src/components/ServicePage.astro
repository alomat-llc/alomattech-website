---
import type { ServicePage as ServicePageRecord } from '../content/site';
import { servicePages, site } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props { readonly service: ServicePageRecord }
const { service } = Astro.props;
const pathname = `/${service.slug}`;
const serviceData = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${site.url}${pathname}/#service`,
  name: service.serviceType,
  description: service.description,
  url: `${site.url}${pathname}`,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.markets,
  audience: { '@type': 'BusinessAudience', audienceType: 'Product and engineering teams' },
};
const breadcrumbData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: service.serviceType, item: `${site.url}${pathname}` },
  ],
};
const related = service.relatedSlugs.map((slug) => servicePages.find((item) => item.slug === slug)!);
---

<BaseLayout title={service.seoTitle} description={service.description} pathname={pathname} structuredData={[serviceData, breadcrumbData]}>
  <article class="editorial-page service-page">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: service.serviceType }]} />
    <header class="editorial-hero">
      <p>{service.eyebrow}</p>
      <h1>{service.title}</h1>
      <p class="direct-answer">{service.definition}</p>
    </header>

    <section class="editorial-section" aria-labelledby="outcomes-title">
      <h2 id="outcomes-title">What this work enables</h2>
      <ul class="statement-list">{service.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
    </section>

    <section class="editorial-section" aria-labelledby="deliverables-title">
      <h2 id="deliverables-title">How this supports the platform</h2>
      <ul class="deliverable-grid">{service.deliverables.map((deliverable) => <li>{deliverable}</li>)}</ul>
    </section>

    <section class="platform-bridge" aria-labelledby="platform-bridge-title">
      <p>One product / Connected foundations</p>
      <h2 id="platform-bridge-title">This capability operates inside the Alomat publishing platform.</h2>
      <a href="/platform">See the publishing platform</a>
    </section>

    <section class="editorial-section" aria-labelledby="process-title">
      <h2 id="process-title">How delivery works</h2>
      <ol class="process-list">{service.process.map((step, index) => <li><span>0{index + 1}</span><div><h3>{step.title}</h3><p>{step.description}</p></div></li>)}</ol>
    </section>

    <section class="related-section" aria-labelledby="related-title">
      <h2 id="related-title">Related capabilities</h2>
      <div>{related.map((item) => <a href={`/${item.slug}`}>{item.serviceType}<span aria-hidden="true">↗</span></a>)}</div>
    </section>

    <section class="page-cta" aria-labelledby="service-cta-title">
      <p>Start with one publishing workflow.</p>
      <h2 id="service-cta-title">Put this foundation to work inside a managed editorial operation.</h2>
      <a href="/pilot">Request a managed pilot</a>
    </section>
  </article>
</BaseLayout>

<style>
  .platform-bridge {
    display: grid;
    grid-template-columns: 0.45fr 1fr auto;
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: end;
    padding: clamp(3rem, 6vw, 6rem) 0;
    border-bottom: 1px solid var(--ink);
  }

  .platform-bridge > p {
    margin: 0;
    color: var(--signal-dark);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .platform-bridge h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2rem, 4vw, 4.5rem);
    font-weight: 550;
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .platform-bridge a {
    display: inline-block;
    padding: 0.8rem 1rem;
    border: 1px solid var(--ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .platform-bridge {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .platform-bridge a {
      width: fit-content;
    }
  }
</style>
