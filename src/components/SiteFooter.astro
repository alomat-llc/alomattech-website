---
import { appUrl, copy, site, type Lang } from '../content/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p class="copyright">© {year} Alomat LLC</p>
    <nav aria-label={t.footer.label}>
      <a href={appUrl(lang)}>{t.hero.open}</a>
      <a href="/privacy" hreflang="en">{t.footer.privacy}</a>
      <a href="/terms" hreflang="en">{t.footer.terms}</a>
      <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>
