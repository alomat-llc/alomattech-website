---
import { productDemo } from '../content/product-demo';
import { appUrl, copy, feedSample, homePath, screenFiles, site, type Lang } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const app = appUrl(lang);
const videoSrc = '/demo/alomat-news-feed-demo.mp4';
const posterSrc = '/demo/alomat-news-feed-demo-poster.jpg';

const videoData = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: productDemo.title,
  description: productDemo.description,
  thumbnailUrl: new URL(posterSrc, site.url).toString(),
  contentUrl: new URL(videoSrc, site.url).toString(),
  uploadDate: productDemo.recordedOn,
  duration: productDemo.durationIso,
  inLanguage: 'en',
};
const softwareData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Alomat',
  applicationCategory: 'NewsApplication',
  operatingSystem: 'Web, Telegram',
  url: new URL(homePath[lang], site.url).toString(),
  description: t.description,
  inLanguage: t.htmlLang,
  publisher: { '@id': `${site.url}/#organization` },
};
const personData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Habib Salim',
  jobTitle: 'Founder',
  description: copy.en.company.bio,
  sameAs: [site.founderLinkedin],
  worksFor: { '@id': `${site.url}/#organization` },
};
---

<BaseLayout
  title={t.title}
  description={t.description}
  pathname={homePath[lang]}
  lang={lang}
  alternates
  includeOrganizationData
  structuredData={[softwareData, videoData, personData]}
>
  <section class="wrap hero" aria-labelledby="hero-title">
    <div>
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="actions">
        <a class="btn" href={app}>{t.hero.open}</a>
        <a class="btn btn-line" href="#demo">{t.hero.demo}</a>
      </div>
      <p class="note">{t.hero.note}</p>
    </div>
    <div class="shot">
      <img src={screenFiles.home} alt={t.hero.alt} width="1600" height="900" fetchpriority="high" />
    </div>
  </section>

  <section class="band" aria-labelledby="feed-title">
    <div class="wrap">
      <h2 id="feed-title">{t.feed.title}</h2>
      <p class="lead">{t.feed.lead}</p>
      <ul class="feed">
        {
          feedSample.map((item) => (
            <li lang="uz-Latn">
              <small>{item.source} · {item.date}</small>
              <span>{item.headline}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="product" class="section" aria-labelledby="product-title">
    <div class="wrap">
      <h2 id="product-title">{t.product.title}</h2>
      <p class="lead">{t.product.lead}</p>
      <div class="rows">
        {
          t.screens.map((screen) => (
            <article class="row" id={screen.id}>
              <div class="shot">
                <img src={screenFiles[screen.id]} alt={screen.alt} width="1600" height="900" loading="lazy" decoding="async" />
              </div>
              <div>
                <h3>{screen.title}</h3>
                <p>{screen.description}</p>
              </div>
            </article>
          ))
        }
      </div>
      <ol class="steps" aria-label={t.product.stepsLabel}>
        {
          t.steps.map((step, index) => (
            <li>
              <span aria-hidden="true">{index + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="demo" class="band" aria-labelledby="demo-title">
    <div class="wrap">
      <h2 id="demo-title">{t.demo.title}</h2>
      <p class="lead">{t.demo.lead}</p>
      <video controls preload="none" playsinline poster={posterSrc} width="1920" height="1080">
        <source src={videoSrc} type="video/mp4" />
        <a href={videoSrc}>{t.demo.download}</a>
      </video>
    </div>
  </section>

  <section id="stage" class="section" aria-labelledby="stage-title">
    <div class="wrap">
      <h2 id="stage-title">{t.stage.title}</h2>
      <p class="lead">{t.stage.summary}</p>
      <div class="stage">
        {
          t.stage.products.map((product) => (
            <article>
              <span class:list={['tag', { dev: !product.live }]}>{product.status}</span>
              <h3>{product.title}</h3>
              <p>{product.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section join-section" aria-labelledby="join-title">
    <div class="wrap">
      <div class="join">
        <div>
          <h2 id="join-title">{t.join.title}</h2>
          <p class="lead">{t.join.lead}</p>
          <p class="actions"><a class="btn" href={app}>{t.hero.open}</a></p>
        </div>
        <div class="shot">
          <img src={screenFiles.signin} alt={t.join.alt} width="1200" height="920" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section id="company" class="band" aria-labelledby="company-title">
    <div class="wrap company">
      <h2 id="company-title">{t.company.title}</h2>
      <div>
        <article data-team-member>
          <h3>{t.company.founder}</h3>
          <p>{t.company.bio}</p>
          <p>
            <a href={site.founderLinkedin} target="_blank" rel="noopener">{t.company.founderLinkedin}</a> ·{' '}
            <a href={site.linkedin} target="_blank" rel="noopener">{t.company.companyLinkedin}</a>
          </p>
        </article>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a> · <a href={`mailto:${site.founderEmail}`}>{site.founderEmail}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 56px;
    align-items: center;
    padding-top: 48px;
    padding-bottom: 88px;
  }

  .actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 32px 0 0;
  }

  .note {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  .section,
  .band {
    padding-block: 88px;
  }

  .band {
    background: var(--tint);
  }

  .feed {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
    max-width: 560px;
  }

  .feed li {
    background: var(--raised);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }

  .feed small {
    display: block;
    color: var(--muted);
    font-size: 14px;
  }

  .feed span {
    display: block;
    margin-top: 4px;
    font-weight: 600;
  }

  .rows {
    display: grid;
    gap: 72px;
    margin-top: 56px;
  }

  .row {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .row:nth-child(even) .shot {
    order: 2;
  }

  .row p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 72px 0 0;
  }

  .steps li {
    background: var(--raised);
    border-radius: var(--radius-md);
    padding: 24px;
  }

  .steps span {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--anor-soft);
    color: var(--anor);
    font-weight: 700;
    margin-bottom: 14px;
  }

  .steps h3 {
    font-size: 19px;
  }

  .steps p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  video {
    width: 100%;
    border-radius: var(--radius-lg);
    margin-top: 40px;
    background: #000;
  }

  .stage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 36px;
  }

  .stage article {
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 28px;
  }

  .stage p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .tag {
    display: inline-block;
    font-size: 14px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--success-soft);
    color: var(--success);
    margin-bottom: 12px;
  }

  .tag.dev {
    background: var(--tint);
    color: var(--muted);
  }

  .join-section {
    padding-top: 0;
  }

  .join {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    background: var(--raised);
    border-radius: var(--radius-lg);
    padding: 48px;
  }

  .company {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 48px;
  }

  .company p {
    color: var(--muted);
    margin: 12px 0 0;
  }

  @media (max-width: 900px) {
    .hero,
    .row,
    .stage,
    .join,
    .company {
      grid-template-columns: 1fr;
    }

    .hero {
      gap: 40px;
      padding-top: 24px;
    }

    .row {
      gap: 20px;
    }

    .row:nth-child(even) .shot {
      order: 0;
    }

    .steps {
      grid-template-columns: 1fr 1fr;
    }

    .join {
      padding: 28px;
    }

    .section,
    .band {
      padding-block: 64px;
    }
  }
</style>
