---
import { deploymentPatterns } from '../content/site';
---

<section class="studio section-frame" aria-labelledby="studio-title">
  <aside class="production-proof" data-production-proof aria-labelledby="proof-title">
    <p>Production evidence</p>
    <h2 id="proof-title">In production with an active digital publisher.</h2>
    <ul>
      <li>Live source monitoring</li>
      <li>Archive-backed editorial memory</li>
      <li>Specialist agent workflow</li>
      <li>Human approval before delivery</li>
    </ul>
  </aside>

  <div id="deployments" class="deployments">
  <header class="studio-heading">
    <p>Deployment patterns</p>
    <h2 id="studio-title">Built from live publishing workflows, not a prompt demo.</h2>
    <p class="studio-lede">
      Three operating patterns shaped the platform. Customer identity and operational details remain private.
    </p>
  </header>

  <div class="experience-list">
    {
      deploymentPatterns.map((note, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <p class="experience-label">{note.label}</p>
          <h3>{note.title}</h3>
          <p>{note.description}</p>
          <ul aria-label={`${note.title} evidence`}>
            {note.evidence.map((item) => <li>{item}</li>)}
          </ul>
        </article>
      ))
    }
  </div>
  </div>
</section>

<style>
  .section-frame {
    padding: var(--section-space) var(--gutter);
  }

  .production-proof {
    display: grid;
    grid-template-columns: 0.45fr 1.05fr 1fr;
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: start;
    margin-bottom: var(--section-space);
    padding: clamp(2rem, 4vw, 4rem);
    border: 1px solid var(--ink);
    background: var(--signal);
  }

  .production-proof > p {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .production-proof h2 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.2rem, 4.8vw, 5.25rem);
    font-weight: 560;
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .production-proof ul,
  .experience-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .production-proof li,
  .experience-list li {
    padding: 0.65rem 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 45%, transparent);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .studio-heading {
    display: grid;
    grid-template-columns: 0.5fr 1.3fr 0.7fr;
    gap: clamp(1.5rem, 4vw, 5rem);
    align-items: end;
    margin-bottom: clamp(5rem, 10vw, 10rem);
  }

  .studio-heading > p:first-child,
  .experience-label {
    color: var(--signal-dark);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .studio-heading > p:first-child {
    align-self: start;
    margin: 0;
  }

  .studio-heading h2 {
    max-width: 12ch;
    margin: 0;
    font-size: var(--heading);
    font-weight: 520;
    letter-spacing: -0.065em;
    line-height: 0.93;
  }

  .studio-lede {
    max-width: 27rem;
    margin: 0;
    color: var(--muted);
  }

  .experience-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--ink);
  }

  .experience-list article {
    display: flex;
    flex-direction: column;
    min-height: 34rem;
    padding: 1.5rem clamp(1.25rem, 3vw, 3.5rem) 2rem 0;
    border-right: 1px solid var(--line);
  }

  .experience-list article + article {
    padding-left: clamp(1.25rem, 3vw, 3.5rem);
  }

  .experience-list article:last-child {
    border-right: 0;
  }

  .experience-list article > span {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }

  .experience-label {
    margin: 3rem 0 1.5rem;
  }

  .experience-list h3 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2rem, 3.5vw, 4rem);
    font-weight: 530;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .experience-list article > p:last-child {
    max-width: 31rem;
    margin: 2rem 0 0;
    color: var(--muted);
  }

  .experience-list article > ul {
    margin-top: auto;
    padding-top: 2rem;
  }

  @media (max-width: 900px) {
    .production-proof {
      grid-template-columns: 1fr;
    }

    .studio-heading {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .experience-list {
      grid-template-columns: 1fr;
    }

    .experience-list article,
    .experience-list article + article {
      min-height: 31rem;
      padding: 1.5rem 0 2.5rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
