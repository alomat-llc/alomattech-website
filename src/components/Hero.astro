---
import { site } from '../content/site';

---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-meta hero-reveal">
    <span>Alomat LLC</span>
    <span>{site.category}</span>
  </div>

  <div class="hero-copy">
    <p class="hero-wordmark hero-reveal" aria-hidden="true">.alomat</p>
    <h1 class="hero-reveal" id="hero-title">{site.tagline}</h1>
    <div class="hero-intro hero-reveal">
      <p>{site.description}</p>
      <div class="hero-actions">
        <a class="text-link" href="/pilot">
          <span>Request a managed pilot</span>
          <svg viewBox="0 0 40 16" aria-hidden="true">
            <path d="M0 8h37M31 2l6 6-6 6"></path>
          </svg>
        </a>
        <a class="platform-cta" href="/platform">Explore the platform</a>
        <a class="demo-cta" href="/demo">Watch the 60-second product demo</a>
      </div>
    </div>
  </div>

  <div class="signal-wrap hero-reveal" aria-hidden="true">
    <svg
      class="signal-field"
      viewBox="0 0 920 620"
      preserveAspectRatio="xMidYMid meet"
      data-signal-field
    >
      <g class="signal-grid">
        <path d="M72 62v500M232 62v500M392 62v500M552 62v500M712 62v500M872 62v500"></path>
        <path d="M40 122h840M40 282h840M40 442h840"></path>
      </g>
      <path
        class="signal-path signal-path-muted"
        d="M72 442C148 442 156 282 232 282S316 122 392 122s84 160 160 160 84 160 160 160 84-160 160-160"
      ></path>
      <path
        class="signal-path signal-path-active"
        pathLength="1"
        d="M72 442C148 442 156 282 232 282S316 122 392 122s84 160 160 160 84 160 160 160 84-160 160-160"
      ></path>
      <g class="signal-node node-a" transform="translate(72 442)">
        <circle r="8"></circle>
        <text x="-4" y="-24">SOURCE</text>
      </g>
      <g class="signal-node node-b" transform="translate(232 282)">
        <circle r="8"></circle>
        <text x="-4" y="-24">VERIFY</text>
      </g>
      <g class="signal-node node-c" transform="translate(392 122)">
        <circle r="8"></circle>
        <text x="-4" y="-24">MEMORY</text>
      </g>
      <g class="signal-node node-d" transform="translate(552 282)">
        <circle r="8"></circle>
        <text x="-4" y="-24">COMPOSE</text>
      </g>
      <g class="signal-node node-e" transform="translate(712 442)">
        <circle r="8"></circle>
        <text x="-4" y="-24">REVIEW</text>
      </g>
      <g class="signal-node node-f" transform="translate(872 282)">
        <circle r="8"></circle>
        <text x="-76" y="-24">DELIVER</text>
      </g>
      <g class="signal-index">
        <text x="48" y="94">01</text>
        <text x="208" y="94">02</text>
        <text x="368" y="94">03</text>
        <text x="528" y="94">04</text>
        <text x="688" y="94">05</text>
        <text x="848" y="94">06</text>
      </g>
    </svg>
  </div>

  <div class="hero-foot hero-reveal">
    <span>Sources · Memory · Agents · Human approval</span>
    <span>Scroll to inspect</span>
  </div>
</section>

<script>
  import '../scripts/signal-field';
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
    padding: 7.5rem var(--gutter) 2rem;
    overflow: hidden;
    border-bottom: 1px solid var(--ink);
  }

  .hero-meta,
  .hero-foot {
    display: flex;
    justify-content: space-between;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-meta {
    position: relative;
    z-index: 2;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.55fr);
    grid-template-rows: auto auto;
    align-content: center;
    column-gap: clamp(2rem, 6vw, 8rem);
    padding: 3vh 0 5vh;
  }

  .hero-wordmark {
    grid-column: 1 / -1;
    margin: 0;
    font-size: clamp(5.6rem, 17vw, 17.5rem);
    font-weight: 850;
    letter-spacing: -0.09em;
    line-height: 0.72;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(2.7rem, 5.5vw, 6.4rem);
    font-weight: 500;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .hero-intro {
    align-self: end;
    max-width: 29rem;
    padding-bottom: 0.4rem;
  }

  .hero-intro p {
    margin: 0 0 1.75rem;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.1rem;
    align-items: center;
  }

  .text-link {
    display: inline-flex;
    gap: 1rem;
    align-items: center;
    min-height: 44px;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--ink);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .text-link svg {
    width: 2.5rem;
    overflow: visible;
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.5;
    transition: transform 180ms var(--ease-out);
  }

  .text-link:hover svg,
  .text-link:focus-visible svg {
    transform: translateX(0.4rem);
  }

  .platform-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem 1rem;
    border: 1px solid var(--ink);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background 180ms var(--ease-out),
      color 180ms var(--ease-out);
  }

  .platform-cta:hover,
  .platform-cta:focus-visible {
    background: var(--ink);
    color: var(--canvas);
  }

  .demo-cta {
    width: 100%;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-transform: uppercase;
    text-underline-offset: 0.35rem;
  }

  .signal-wrap {
    position: absolute;
    z-index: 1;
    right: -5vw;
    bottom: 1vh;
    width: min(58vw, 920px);
    opacity: 0.34;
    transform: translate3d(var(--signal-x, 0), var(--signal-y, 0), 0);
    transition: transform 500ms var(--ease-out);
  }

  .signal-grid path {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .signal-path {
    fill: none;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .signal-path-muted {
    stroke: var(--ink);
    opacity: 0.28;
  }

  .signal-path-active {
    stroke: var(--signal);
    stroke-dasharray: 1;
    stroke-dashoffset: calc(1 - var(--signal-progress, 0.72));
  }

  .signal-node circle {
    fill: var(--signal);
  }

  .signal-node text,
  .signal-index text {
    fill: var(--ink);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .signal-index text {
    fill: var(--muted);
    font-size: 11px;
  }

  .hero-foot {
    position: relative;
    z-index: 3;
    align-items: end;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  html[data-motion='full'] .hero-reveal {
    animation: hero-enter 700ms both var(--ease-out);
  }

  html[data-motion='full'] .hero-copy .hero-reveal:nth-child(2) {
    animation-delay: 100ms;
  }

  html[data-motion='full'] .hero-copy .hero-reveal:nth-child(3) {
    animation-delay: 180ms;
  }

  html[data-motion='full'] .signal-wrap {
    animation-delay: 260ms;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @media (max-width: 900px) {
    .hero-copy {
      grid-template-columns: 1fr;
      align-content: center;
      gap: 2rem;
    }

    .hero-wordmark {
      line-height: 0.8;
    }

    .hero-intro {
      max-width: 24rem;
    }

    .signal-wrap {
      right: -24vw;
      bottom: 2vh;
      width: 95vw;
      opacity: 0.2;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: 100svh;
      padding-top: 6.25rem;
      padding-bottom: 1.25rem;
    }

    .hero-meta span:last-child,
    .hero-foot span:last-child {
      display: none;
    }

    .hero-copy {
      gap: 1.75rem;
      padding: 2rem 0 3rem;
    }

    .hero-wordmark {
      font-size: clamp(5rem, 28vw, 7.25rem);
    }

    h1 {
      max-width: 11ch;
      font-size: clamp(2.75rem, 12.5vw, 4.35rem);
    }

    .hero-intro p {
      max-width: 22rem;
      margin-bottom: 1.1rem;
    }

    .hero-actions {
      align-items: stretch;
    }

    .platform-cta {
      flex: 1 1 100%;
    }

    .hero-foot {
      font-size: 0.58rem;
    }
  }
</style>
