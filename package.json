{
  "name": "alomattech-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:worker": "npx wrangler@4.111.0 deploy --config wrangler.pilot.jsonc --dry-run",
    "check:worker-types": "tsc --noEmit --project tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "video:render": "remotion render video/index.ts PublishingDemo public/demo/alomat-agentic-publishing-demo.mp4 --codec h264 --crf 20 --pixel-format yuv420p",
    "video:poster": "remotion still video/index.ts PublishingDemo public/demo/alomat-agentic-publishing-demo-poster.jpg --frame 1290 --image-format jpeg --jpeg-quality 92",
    "types:worker": "npx wrangler@4.111.0 types workers/worker-configuration.d.ts --config wrangler.pilot.jsonc"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.61.1",
    "@remotion/cli": "^4.0.490",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.490",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  }
}
